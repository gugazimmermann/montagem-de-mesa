# Projeto Supabase → Settings → API
# Use a Project URL (https://....supabase.co), NÃO a connection string do Postgres
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica

# Apenas para npm run seed:supabase (nunca no frontend / Vite / Render)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Opcional: npm run db:migrate (Settings → Database → Connection string URI)
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres
