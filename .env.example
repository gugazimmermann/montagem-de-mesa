# =============================================================================
# Copie para .env e preencha:  cp .env.example .env
# Nunca commite o .env (está no .gitignore).
# =============================================================================

# --- Seed (só npm run seed:supabase) -----------------------------------------
# Senha do usuário Auth demo criado/atualizado pelo seed (mín. 10 caracteres).
# Não é usada pelo frontend em runtime.
SEED_PASSWORD=

# E-mail do usuário demo (opcional). Padrão se omitir: financeiroraffiner@gmail.com
# SEED_EMAIL=contato@raffiner.com.br

# --- Supabase · frontend (Vite / Render build) -------------------------------
# Dashboard → Project Settings → API
# URL = Project URL (https://….supabase.co). NÃO use a connection string Postgres.
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave anon public (segura no browser; RLS protege os dados)
VITE_SUPABASE_ANON_KEY=

# Auth → URL Configuration — Redirect URLs (local):
#   http://localhost:5173/admin
#   http://localhost:5173/admin/redefinir-senha
#   http://localhost:5173/admin/painel/cadastro
# Site URL: http://localhost:5173 (em produção, o domínio do site)

# --- Supabase · scripts locais (nunca no Vite / Render) ----------------------
# Dashboard → Project Settings → API → service_role (secret)
# Usado por: npm run seed:supabase
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Project Settings → Database → Connection string → URI
# Substitua [YOUR-PASSWORD]; caracteres especiais na senha: URL-encode
#   + → %2B   & → %26   % → %25   @ → %40   ? → %3F
# Preferir conexão direta (porta 5432), não o pooler, para migrations.
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# Se npm run db:migrate falhar com "self-signed certificate in certificate chain":
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Stripe (assinatura) -----------------------------------------------------
# Price ID do plano mensal (Dashboard Stripe → Products)
STRIPE_PRICE_ID=price_...

# Publishable key — opcional no frontend (Checkout por redirect não exige)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key e webhook — também devem ir nos Secrets das Edge Functions
# (Dashboard Supabase → Edge Functions → Secrets ou: supabase secrets set …)
# NÃO exponha no Vite/Render do frontend.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret do endpoint: https://SEU_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Origem do app (retorno do Checkout / Portal). Em produção: https://seu-dominio.com
SITE_URL=http://localhost:5173

# --- Resend (e-mail ao enviar montagem) --------------------------------------
# Também nos Secrets das Edge Functions (nunca só no Vite).
RESEND_API_KEY=re_...
# Em testes: onboarding@resend.dev | Em produção: domínio verificado no Resend
RESEND_FROM=Montagem de Mesa <onboarding@resend.dev>

# --- Secrets das Edge Functions (checklist) ----------------------------------
# Configure no projeto Supabase (não bastam só no .env local):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID, SITE_URL,
#   RESEND_API_KEY, RESEND_FROM
# Já injetados pelo Supabase: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# --- Observabilidade (opcional) ----------------------------------------------
# VITE_SENTRY_DSN=
