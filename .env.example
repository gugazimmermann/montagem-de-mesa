# Projeto Supabase → Settings → API
# Use a Project URL (https://....supabase.co), NÃO a connection string do Postgres
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica

# Auth → URL Configuration: adicione em Redirect URLs:
#   http://localhost:5173/admin
#   http://localhost:5173/admin/redefinir-senha
#   http://localhost:5173/admin/painel/cadastro
# (confirmação de e-mail → /admin; reset → /admin/redefinir-senha; troca de e-mail → /admin/painel/cadastro)

# Apenas para npm run seed:supabase (nunca no frontend / Vite / Render)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Opcional: npm run db:migrate e seed transacional (Settings → Database → Connection string URI)
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU_REF.supabase.co:5432/postgres

# Seed (SEED_PASSWORD obrigatório; e-mail opcional)
# SEED_EMAIL=financeiroraffiner@gmail.com
SEED_PASSWORD=

# --- Stripe (assinatura) ---
# Secrets das Edge Functions (Dashboard Supabase → Edge Functions → Secrets),
# NÃO no Vite/Render do frontend:
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_ID=price_...
#   SITE_URL=http://localhost:5173
# Opcional no frontend (Checkout por redirect não exige):
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Enviar montagem (e-mail ao admin) ---
# Secrets das Edge Functions (nunca no Vite):
#   RESEND_API_KEY=re_...
#   RESEND_FROM=Montagem de Mesa <onboarding@resend.dev>
# Em produção, use um domínio verificado no Resend (ex.: Montagem <noreply@seudominio.com>).
